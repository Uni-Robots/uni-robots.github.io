---
import { Font, getImage } from 'astro:assets';
import logo from '../assets/logo.png';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { canonicalPath, pageSlug } from '../lib/page';

interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = 'UniRobot: equipe universitária de robótica competitiva de São José dos Pinhais (PR).',
} = Astro.props;

const favicon = await getImage({ src: logo, width: 96, format: 'png' });

const fullTitle = `UniRobot - ${title}`;
const canonical = new URL(canonicalPath(pageSlug(Astro.url)), Astro.site);
// Prévia ao compartilhar o link (WhatsApp, LinkedIn...): o logo sobre o fundo do site,
// 1200x630 em JPEG (formato aceito por todas as redes).
const ogImage = await getImage({
    src: logo,
    width: 1200,
    height: 630,
    fit: 'contain',
    background: '#1a1a2e',
    format: 'jpeg',
    quality: 85,
});
const ogImageUrl = new URL(ogImage.src, Astro.site);
---

<!doctype html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{fullTitle}</title>
        <meta name="description" content={description}>
        <meta name="theme-color" content="#1a1a2e">
        <link rel="canonical" href={canonical}>
        <link rel="icon" type="image/png" href={favicon.src}>
        <link rel="sitemap" href="/sitemap-index.xml">

        <meta property="og:type" content="website">
        <meta property="og:site_name" content="UniRobot">
        <meta property="og:locale" content="pt_BR">
        <meta property="og:title" content={fullTitle}>
        <meta property="og:description" content={description}>
        <meta property="og:url" content={canonical}>
        <meta property="og:image" content={ogImageUrl}>
        <meta property="og:image:type" content="image/jpeg">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta property="og:image:alt" content="Logo da UniRobot: a palavra Uni e um robô roxo em pixel art">
        <meta name="twitter:card" content="summary_large_image">

        <slot name="head" />
        <Font cssVariable="--font-text" preload />
        <Font cssVariable="--font-pixel" preload />
        <!-- Ícones: Font Awesome Free 6.4.0 by @fontawesome - https://fontawesome.com - CC BY 4.0 -->
    </head>
    <body>
        <a class="pular" href="#conteudo">Pular para o conteúdo</a>
        <Header />
        <main id="conteudo" tabindex="-1">
            <slot />
        </main>
        <Footer />
    </body>
</html>
