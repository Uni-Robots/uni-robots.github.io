---
import { Font, getImage } from 'astro:assets';
import logo from '../assets/logo.png';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/main.css';
import '../styles/responsive.css';

interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = 'UniRobot - Equipe de robótica competitiva. Inovação, tecnologia e robótica para o futuro.',
} = Astro.props;

const favicon = await getImage({ src: logo, width: 96, format: 'png' });
---

<!doctype html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
        <title>UniRobot - {title}</title>
        <meta name="description" content={description}>
        <link rel="icon" type="image/png" href={favicon.src}>
        <Font cssVariable="--font-inter" preload />
        <!-- Ícones: Font Awesome Free 6.4.0 by @fontawesome - https://fontawesome.com - CC BY 4.0 -->
    </head>
    <body>
        <Header />
        <slot />
        <Footer />

        <script>
            // Ponte temporária: JS do site antigo, dividido em módulos na Fase 5.
            import '../scripts/legacy-main.js';
        </script>
    </body>
</html>
