---
import { Font, getImage } from 'astro:assets';
import logo from '../assets/logo.png';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/main.css';
import '../styles/responsive.css';

interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = 'UniRobot - Equipe de robótica competitiva. Inovação, tecnologia e robótica para o futuro.',
} = Astro.props;

const favicon = await getImage({ src: logo, width: 96, format: 'png' });
---

<!doctype html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
        <title>UniRobot - {title}</title>
        <meta name="description" content={description}>
        <link rel="icon" type="image/png" href={favicon.src}>
        <Font cssVariable="--font-inter" preload />
        <script is:inline>
            // Esconde os cards antes da primeira pintura para a animação de entrada (src/scripts/reveal.ts).
            // Se o módulo não carregar em 3s, mostra tudo para o conteúdo nunca ficar invisível.
            if ('IntersectionObserver' in window) {
                document.documentElement.classList.add('js-reveal');
                setTimeout(function () {
                    if (!window.__revealReady) document.documentElement.classList.remove('js-reveal');
                }, 3000);
            }
        </script>
        <!-- Ícones: Font Awesome Free 6.4.0 by @fontawesome - https://fontawesome.com - CC BY 4.0 -->
    </head>
    <body>
        <Header />
        <slot />
        <Footer />

        <script>
            import '../scripts/reveal';
        </script>
    </body>
</html>
