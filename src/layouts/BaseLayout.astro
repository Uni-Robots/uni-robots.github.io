---
import { Font, getImage } from 'astro:assets';
import logo from '../assets/logo.png';
import ogSource from '../assets/sobre-equipe.webp';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/main.css';
import '../styles/responsive.css';
import { canonicalPath, pageSlug } from '../lib/page';

interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = 'UniRobot - Equipe de robótica competitiva. Inovação, tecnologia e robótica para o futuro.',
} = Astro.props;

const favicon = await getImage({ src: logo, width: 96, format: 'png' });

const fullTitle = `UniRobot - ${title}`;
const canonical = new URL(canonicalPath(pageSlug(Astro.url)), Astro.site);
// Prévia ao compartilhar o link (WhatsApp, LinkedIn, Instagram...): 1200x630 em JPEG,
// formato aceito por todas as redes, recortado da arte da página Sobre.
const ogImage = await getImage({ src: ogSource, width: 1200, height: 630, fit: 'cover', format: 'jpeg', quality: 85 });
const ogImageUrl = new URL(ogImage.src, Astro.site);
---

<!doctype html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
        <title>{fullTitle}</title>
        <meta name="description" content={description}>
        <link rel="canonical" href={canonical}>
        <link rel="icon" type="image/png" href={favicon.src}>
        <link rel="sitemap" href="/sitemap-index.xml">

        <meta property="og:type" content="website">
        <meta property="og:site_name" content="UniRobot">
        <meta property="og:locale" content="pt_BR">
        <meta property="og:title" content={fullTitle}>
        <meta property="og:description" content={description}>
        <meta property="og:url" content={canonical}>
        <meta property="og:image" content={ogImageUrl}>
        <meta property="og:image:type" content="image/jpeg">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta property="og:image:alt" content="UniRobot - Robótica, Inovação e Tecnologia">
        <meta name="twitter:card" content="summary_large_image">

        <slot name="head" />
        <Font cssVariable="--font-inter" preload />
        <script is:inline>
            // Esconde os cards antes da primeira pintura para a animação de entrada (src/scripts/reveal.ts).
            // Se o módulo não carregar em 3s, mostra tudo para o conteúdo nunca ficar invisível.
            if ('IntersectionObserver' in window) {
                document.documentElement.classList.add('js-reveal');
                setTimeout(function () {
                    if (!window.__revealReady) document.documentElement.classList.remove('js-reveal');
                }, 3000);
            }
        </script>
        <!-- Ícones: Font Awesome Free 6.4.0 by @fontawesome - https://fontawesome.com - CC BY 4.0 -->
    </head>
    <body>
        <Header />
        <slot />
        <Footer />

        <script>
            import '../scripts/reveal';
        </script>
    </body>
</html>
