---
import logo from '../assets/logo.png';
---

<footer class="footer">
    <div class="container">
        <div class="footer-content">
            <div class="footer-logo">
                <img src={logo.src} alt="UniRobot">
                <p>Construindo o futuro com robótica e inovação.</p>
            </div>
            <div class="footer-links">
                <h4>Links Rápidos</h4>
                <ul>
                    <li><a href="/index.html">Início</a></li>
                    <li><a href="/sobre.html">Sobre</a></li>
                    <li><a href="/projetos.html">Projetos</a></li>
                    <li><a href="/equipe.html">Equipe</a></li>
                </ul>
            </div>
            <div class="footer-links">
                <h4>Mais</h4>
                <ul>
                    <li><a href="/patrocinadores.html">Patrocinadores</a></li>
                    <li><a href="/contato.html">Contato</a></li>
                    <li><a href="https://www.instagram.com/unirobot_/" target="_blank">Instagram</a></li>
                    <li><a href="https://github.com/Uni-Robots" target="_blank">GitHub</a></li>
                </ul>
            </div>
            <div class="footer-newsletter">
                <h4>Newsletter</h4>
                <p>Receba nossas novidades</p>
                <form id="newsletterForm">
                    <input type="email" name="email" placeholder="Seu e-mail" required>
                    <button type="submit" aria-label="Inscrever"><i class="fas fa-paper-plane"></i></button>
                </form>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 UniRobot - Equipe de Robótica. Todos os direitos reservados.</p>
        </div>
    </div>
</footer>
