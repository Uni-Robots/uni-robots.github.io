---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

const paginas = [
    { href: '/sobre.html', label: 'Sobre' },
    { href: '/projetos.html', label: 'Robôs' },
    { href: '/equipe.html', label: 'Equipe' },
    { href: '/patrocinadores.html', label: 'Patrocínio' },
    { href: '/contato.html', label: 'Contato' },
];

const redes = [
    { href: 'https://www.instagram.com/unirobot_/', label: 'Instagram' },
    { href: 'https://github.com/Uni-Robots', label: 'GitHub' },
    { href: 'https://linkedin.com', label: 'LinkedIn' },
];
---

<footer class="rodape">
    <div class="container grade">
        <div class="sobre">
            <Image src={logo} alt="UniRobot" width={120} widths={[120, 240]} sizes="120px" />
            <p>Equipe universitária de robótica competitiva de São José dos Pinhais, PR.</p>
        </div>

        <nav aria-label="Páginas">
            <h2 class="titulo">Páginas</h2>
            <ul>
                {paginas.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}
            </ul>
        </nav>

        <div>
            <h2 class="titulo"><a href="/redes.html">Redes</a></h2>
            <ul>
                {redes.map(({ href, label }) => <li><a href={href} target="_blank" rel="noopener noreferrer">{label}</a></li>)}
            </ul>
        </div>

        <form id="newsletterForm" class="novidades">
            <label for="newsletter-email" class="titulo">Novidades por e-mail</label>
            <p class="apoio">Competições, resultados e vagas na equipe.</p>
            <div class="linha-form">
                <input id="newsletter-email" type="email" name="email" autocomplete="email" placeholder="seu@email.com" required>
                <button type="submit" class="btn">Inscrever</button>
            </div>
            <p class="status" role="status" aria-live="polite"></p>
        </form>
    </div>
    <div class="container">
        <p class="base">&copy; 2026 UniRobot</p>
    </div>
</footer>

<style>
    .rodape {
        background: var(--arena);
        border-top: 2px solid var(--linha);
        padding-top: clamp(3rem, 6vw, 4.5rem);
        font-size: 0.9375rem;
    }

    .grade {
        display: grid;
        grid-template-columns: 1.3fr 0.7fr 0.7fr 1.6fr;
        gap: 2.5rem;
    }

    .sobre img {
        width: 120px;
        height: auto;
        margin-bottom: 1rem;
    }

    .sobre p {
        color: var(--neblina);
        max-width: 28ch;
    }

    .titulo {
        display: block;
        font-family: var(--font-text);
        font-size: 0.9375rem;
        font-weight: 700;
        margin-bottom: 0.75rem;
    }

    .titulo a {
        color: inherit;
        text-decoration: none;
    }

    ul {
        list-style: none;
        padding: 0;
        display: grid;
        gap: 0.4rem;
    }

    ul a {
        color: var(--neblina);
        text-decoration: none;
    }

    ul a:hover,
    .titulo a:hover {
        color: var(--giz);
        text-decoration: underline;
    }

    .novidades .apoio {
        margin-bottom: 0.75rem;
    }

    .linha-form {
        display: flex;
        gap: 0.5rem;
    }

    .linha-form input {
        flex: 1;
        min-width: 0;
        padding: 0.7rem 0.8rem;
        background: var(--noite);
        border: 2px solid var(--contorno);
    }

    .linha-form input:focus-visible {
        outline: none;
        border-color: var(--azul);
    }

    .base {
        max-width: none;
        margin-top: clamp(2.5rem, 5vw, 3.5rem);
        padding-block: 1.25rem;
        border-top: 2px solid var(--linha);
        color: var(--neblina);
    }

    @media (max-width: 900px) {
        .grade {
            grid-template-columns: 1fr 1fr;
        }

        .sobre,
        .novidades {
            grid-column: 1 / -1;
        }
    }
</style>

<script>
    import { ACCESS_KEYS, SPINNER_HTML, handleWeb3Form } from '../scripts/web3forms';

    handleWeb3Form(document.querySelector<HTMLFormElement>('#newsletterForm'), {
        accessKey: ACCESS_KEYS.contato,
        subject: () => 'Newsletter - Novo inscrito',
        busyHTML: `${SPINNER_HTML} Enviando`,
        onSuccess: (form) => {
            form.reset();
            const status = form.querySelector('.status');
            if (status) status.textContent = 'Inscrição feita. As novidades chegam no seu e-mail.';
        },
    });
</script>
