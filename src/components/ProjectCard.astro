---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
    project: CollectionEntry<'projects'>;
}

const { title, description, icon, easterEgg } = Astro.props.project.data;
---

{/* Cards com easterEgg abrem o "Protocolo Resenha" (ResenhaEasterEgg.astro). */}
<div class:list={['project-card', { 'sumo-project': easterEgg }]} data-easter-egg={easterEgg ? '' : undefined}>
    <div class="project-icon"><Icon name={icon} /></div>
    <h3>{title}</h3>
    <p>{description}</p>
    {easterEgg && <div class="sumo-tooltip">🥋 Clique para ativar PROTOCOLO RESENHA 🥋</div>}
</div>
