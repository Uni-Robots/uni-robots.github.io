---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
    project: CollectionEntry<'projects'>;
}

const { title, description, icon, easterEgg } = Astro.props.project.data;
---

<div class="project-card" data-easter-egg={easterEgg ? '' : undefined}>
    <div class="project-icon"><Icon name={icon} /></div>
    <h3>{title}</h3>
    <p>{description}</p>
</div>
