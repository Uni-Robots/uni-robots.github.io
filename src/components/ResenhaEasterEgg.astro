---
// Easter egg da página Projetos: clicar num card de sumô pergunta se deve ativar o
// "Protocolo Resenha", que mostra uma imagem em tela cheia e toca um bipe.
import { Image } from 'astro:assets';
import resenha from '../assets/resenha.webp';
---

<div class="resenha-confirm" id="resenhaConfirm" hidden>
    <div class="resenha-confirm-box" role="dialog" aria-modal="true" aria-labelledby="resenhaConfirmTitle">
        <div class="resenha-confirm-emoji">🥋🤖</div>
        <h3 id="resenhaConfirmTitle"></h3>
        <p>Deseja ativar o PROTOCOLO RESENHA?</p>
        <div class="resenha-confirm-actions">
            <button type="button" id="resenhaSim">✅ SIM, ATIVAR!</button>
            <button type="button" id="resenhaNao">❌ CANCELAR</button>
        </div>
    </div>
</div>

<div class="resenha-modal" id="protocoloResenhaModal" hidden>
    <div class="resenha-content">
        <Image src={resenha} alt="PROTOCOLO RESENHA ATIVADO" />
        <h2>🔓 PROTOCOLO RESENHA ATIVADO! 🔓</h2>
        <p>Clique em qualquer lugar para fechar</p>
    </div>
</div>

<style>
    /* Mesmos estilos que o JS antigo aplicava inline. */
    .resenha-confirm:not([hidden]) {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.8);
        z-index: 10001;
        display: flex;
        justify-content: center;
        align-items: center;
        animation: fadeIn 0.3s ease;
        font-family: var(--font-inter), sans-serif;
    }

    .resenha-confirm-box {
        background: linear-gradient(135deg, #1a1a2e, #0f0f1a);
        border-radius: 20px;
        padding: 30px;
        max-width: 400px;
        width: 90%;
        text-align: center;
        animation: zoomIn 0.3s ease;
        border: 2px solid #00a8ff;
        box-shadow: 0 0 30px rgba(0, 168, 255, 0.3);
    }

    .resenha-confirm-emoji {
        font-size: 50px;
        margin-bottom: 20px;
    }

    .resenha-confirm-box h3 {
        color: #00a8ff;
        margin-bottom: 15px;
        font-size: 1.3rem;
    }

    .resenha-confirm-box p {
        color: #fff;
        margin-bottom: 25px;
        font-size: 1.1rem;
    }

    .resenha-confirm-actions {
        display: flex;
        gap: 15px;
        justify-content: center;
    }

    .resenha-confirm-actions button {
        padding: 12px 24px;
        border-radius: 50px;
        font-weight: bold;
        cursor: pointer;
    }

    #resenhaSim {
        background: linear-gradient(135deg, #00a8ff, #9c88ff);
        border: none;
        color: #fff;
    }

    #resenhaNao {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid #ff3b30;
        color: #ff3b30;
    }

    .resenha-modal:not([hidden]) {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.95);
        z-index: 10000;
        display: flex;
        justify-content: center;
        align-items: center;
        animation: fadeIn 0.3s ease;
        cursor: pointer;
    }

    .resenha-content {
        text-align: center;
        animation: zoomIn 0.3s ease;
        max-width: 90%;
        max-height: 90%;
    }

    .resenha-content :global(img) {
        width: auto;
        height: auto;
        max-width: 100%;
        max-height: 80vh;
        border-radius: 20px;
        box-shadow: 0 0 50px rgba(0, 168, 255, 0.5);
        border: 3px solid #00a8ff;
    }

    .resenha-content h2 {
        color: #00a8ff;
        margin-top: 20px;
        font-family: var(--font-inter), sans-serif;
        text-shadow: 0 0 10px rgba(0, 168, 255, 0.5);
    }

    .resenha-content p {
        color: #fff;
        margin-top: 10px;
        font-size: 14px;
        opacity: 0.8;
    }
</style>

<script>
    const confirm = document.getElementById('resenhaConfirm')!;
    const confirmTitle = document.getElementById('resenhaConfirmTitle')!;
    const modal = document.getElementById('protocoloResenhaModal')!;

    function playBeep() {
        try {
            const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
            const ctx = new AudioCtx();
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.frequency.value = 880;
            gain.gain.value = 0.3;
            osc.start();
            gain.gain.exponentialRampToValueAtTime(0.00001, ctx.currentTime + 1);
            osc.stop(ctx.currentTime + 1);
            ctx.resume();
        } catch {
            /* áudio não suportado */
        }
    }

    document.querySelectorAll<HTMLElement>('.project-card[data-easter-egg]').forEach((card) => {
        card.addEventListener('click', (event) => {
            event.stopPropagation();
            confirmTitle.textContent = `"${card.querySelector('h3')?.textContent ?? ''}"`;
            confirm.hidden = false;
        });
    });

    document.getElementById('resenhaSim')!.addEventListener('click', () => {
        confirm.hidden = true;
        modal.hidden = false;
        playBeep();
    });
    document.getElementById('resenhaNao')!.addEventListener('click', () => (confirm.hidden = true));
    confirm.addEventListener('click', (event) => {
        if (event.target === confirm) confirm.hidden = true;
    });
    modal.addEventListener('click', () => (modal.hidden = true));
    document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        confirm.hidden = true;
        modal.hidden = true;
    });
</script>
