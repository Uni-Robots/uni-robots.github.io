---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { pageSlug } from '../lib/page';

const nav = [
    { slug: 'index', label: 'Início' },
    { slug: 'sobre', label: 'Sobre' },
    { slug: 'projetos', label: 'Projetos' },
    { slug: 'equipe', label: 'Equipe' },
    { slug: 'patrocinadores', label: 'Patrocinadores' },
    { slug: 'redes', label: 'Redes Sociais' },
    { slug: 'contato', label: 'Contato' },
];

const current = pageSlug(Astro.url);
---

<header class="header">
    <nav class="navbar">
        <div class="logo">
            <a href="/index.html"><Image src={logo} alt="UniRobot Logo" class="logo-img" width={150} widths={[150, 300]} sizes="150px" loading="eager" /></a>
        </div>
        <ul class="nav-menu">
            {nav.map(({ slug, label }) => (
                <li><a href={`/${slug}.html`} class:list={['nav-link', { active: slug === current }]}>{label}</a></li>
            ))}
        </ul>
        <div class="hamburger">
            <span></span>
            <span></span>
            <span></span>
        </div>
    </nav>
</header>

<script>
    // Menu hambúrguer (mobile): abre/fecha e trava a rolagem da página enquanto aberto.
    const hamburger = document.querySelector('.hamburger');
    const navMenu = document.querySelector('.nav-menu');

    const setOpen = (open: boolean) => {
        hamburger?.classList.toggle('active', open);
        navMenu?.classList.toggle('active', open);
        document.body.style.overflow = open ? 'hidden' : '';
    };

    hamburger?.addEventListener('click', () => setOpen(!navMenu?.classList.contains('active')));
    document.querySelectorAll('.nav-link').forEach((link) => link.addEventListener('click', () => setOpen(false)));
</script>
