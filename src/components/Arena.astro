---
// Elemento principal da página inicial: a arena (dohyo) do sumô de robôs com o
// mascote do logo no centro.
// É o único movimento automático do site (uma vez, ao carregar).
import { getImage } from 'astro:assets';
import logo from '../assets/logo.png';

// Cabeça do robô: recorte do lado direito do próprio logo (1024 x 450).
const mascote = await getImage({ src: logo, width: 430, height: 450, fit: 'cover', position: 'right', format: 'webp' });
---

<figure class="arena">
    <div class="palco">
        <svg viewBox="0 0 400 400" aria-hidden="true" focusable="false">
            <circle class="disco" cx="200" cy="200" r="184" />
            <circle class="borda" cx="200" cy="200" r="184" pathLength="100" />
        </svg>
        <img class="mascote" src={mascote.src} width="430" height="450" alt="" decoding="async" fetchpriority="high">
    </div>
    <figcaption>Arena do sumô mini: 77 cm de diâmetro, para robôs de até 500 g.</figcaption>
</figure>

<style>
    .arena {
        width: min(100%, 26rem);
        margin-inline: auto;
    }

    .palco {
        position: relative;
    }

    svg {
        width: 100%;
        height: auto;
    }

    .disco {
        fill: var(--arena);
    }

    .borda {
        fill: none;
        stroke: var(--giz);
        stroke-width: 12;
        stroke-dasharray: 100;
        animation: desenhar 0.9s steps(16) both;
    }

    /* Mascote no centro da arena */
    .mascote {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 40%;
        height: auto;
        translate: -50% -50%;
        animation: aparecer 0.3s steps(4) 0.95s both;
    }

    figcaption {
        margin-top: 1rem;
        font-size: 0.875rem;
        color: var(--neblina);
        text-align: center;
    }

    @media (prefers-reduced-motion: reduce) {
        .borda,
        .mascote {
            animation: none;
        }
    }

    @keyframes desenhar {
        from { stroke-dashoffset: 100; }
        to { stroke-dashoffset: 0; }
    }

    @keyframes aparecer {
        from { opacity: 0; }
        to { opacity: 1; }
    }
</style>
