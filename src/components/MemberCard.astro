---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
    member: CollectionEntry<'team'>;
    /** Liderança e gestores aparecem com foto maior. */
    destaque?: boolean;
}

const { member, destaque = false } = Astro.props;
const { name, role, photo, linkedin, github } = member.data;
// "Membro de Programação" repete o título da seção; só mostra cargos que dizem algo a mais.
const cargo = role.startsWith('Membro de') ? null : role;
---

<article class:list={['team-member', { destaque }]}>
    {destaque ? (
        <Image src={photo} alt={name} width={256} widths={[256, 512]} sizes="(max-width: 640px) 45vw, 256px" />
    ) : (
        <Image src={photo} alt={name} width={176} widths={[176, 352]} sizes="(max-width: 640px) 45vw, 176px" />
    )}
    <h3>{name}</h3>
    {cargo && <p class="cargo">{cargo}</p>}
    {(linkedin || github) && (
        <p class="links">
            {linkedin && <a href={linkedin} target="_blank" rel="noopener noreferrer" aria-label={`LinkedIn de ${name}`}>LinkedIn</a>}
            {github && <a href={github} target="_blank" rel="noopener noreferrer" aria-label={`GitHub de ${name}`}>GitHub</a>}
        </p>
    )}
</article>

<style>
    .team-member :global(img) {
        width: 100%;
        height: auto;
        aspect-ratio: 1;
        object-fit: cover;
        background: var(--arena);
        border: 2px solid var(--linha);
    }

    h3 {
        margin-top: 0.75rem;
        font-size: var(--t-0);
        line-height: 1.3;
    }

    .destaque h3 {
        font-size: var(--t-1);
    }

    .cargo {
        color: var(--neblina);
        font-size: 0.9375rem;
    }

    .links {
        display: flex;
        gap: 1rem;
        margin-top: 0.35rem;
        font-size: 0.9375rem;
        font-weight: 600;
    }
</style>
