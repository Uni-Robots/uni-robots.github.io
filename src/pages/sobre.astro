---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import sobreEquipe from '../assets/sobre-equipe.webp';
import { getCollection } from 'astro:content';

const totalMembros = (await getCollection('team')).length;
---

<BaseLayout
    title="Sobre"
    description="Conheça a UniRobot, equipe de robótica competitiva fundada em 2020 por estudantes universitários apaixonados por tecnologia, engenharia e inovação."
>
    <main class="page-main">
    <section id="about" class="about">
        <div class="container">
            <h2 class="section-title">Sobre a UniRobot</h2>
            <div class="about-content">
                <div class="about-text">
                    <p>A UniRobot é uma equipe de robótica competitiva formada por estudantes universitários apaixonados por tecnologia, engenharia e inovação.</p>
                    <p>Fundada em 2020, já participamos de diversas competições nacionais e internacionais, sempre buscando superar desafios e desenvolver soluções criativas para problemas complexos.</p>
                    <div class="stats">
                        <div class="stat">
                            <h3>5+</h3>
                            <p>Competições</p>
                        </div>
                        <div class="stat">
                            <h3>{totalMembros}</h3>
                            <p>Membros</p>
                        </div>
                        <div class="stat">
                            <h3>5+</h3>
                            <p>Prêmios</p>
                        </div>
                    </div>
                </div>
                <div class="about-image">
                    <Image src={sobreEquipe} alt="Equipe UniRobot" width={800} widths={[400, 800, 1200]} sizes="(max-width: 1024px) 92vw, 556px" />
                </div>
            </div>
        </div>
    </section>
    </main>
</BaseLayout>
