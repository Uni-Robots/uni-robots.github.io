---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import logo from '../assets/logo.png';

// Dados estruturados (schema.org) para buscadores: nome, logo, contato e redes da equipe.
const logoPng = await getImage({ src: logo, width: 512, format: 'png' });
const organization = {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'UniRobot',
    description: 'Equipe de robótica competitiva formada por estudantes universitários.',
    url: Astro.site?.href,
    logo: new URL(logoPng.src, Astro.site).href,
    email: 'equipe.unirobot@gmail.com',
    foundingDate: '2020',
    address: {
        '@type': 'PostalAddress',
        addressLocality: 'São José dos Pinhais',
        addressRegion: 'PR',
        addressCountry: 'BR',
    },
    sameAs: ['https://www.instagram.com/unirobot_/', 'https://github.com/Uni-Robots'],
};
---

<BaseLayout
    title="Início"
    description="UniRobot: equipe de robótica competitiva formada por estudantes universitários de São José dos Pinhais (PR). Inovação, tecnologia e robótica para o futuro."
>
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(organization)} />
    <section id="home" class="hero">
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <h1 class="hero-title">UniRobot</h1>
            <p class="hero-subtitle">Inovação, Tecnologia e Robótica para o Futuro</p>
            <p class="hero-description">Somos uma equipe apaixonada por robótica, competindo em torneios nacionais, desenvolvendo soluções tecnológicas de ponta.</p>
            <div class="hero-buttons">
                <a href="/contato.html" class="btn btn-primary">Junte-se a Nós</a>
                <a href="/projetos.html" class="btn btn-secondary">Nossos Projetos</a>
            </div>
        </div>
    </section>
</BaseLayout>
