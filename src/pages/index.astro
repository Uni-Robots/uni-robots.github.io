---
// Página provisória da Fase 1: confirma que o CSS antigo e a fonte Inter carregam.
// Será substituída pelo BaseLayout + conteúdo real na Fase 2.
import { Font } from 'astro:assets';
import '../styles/main.css';
import '../styles/responsive.css';
---

<!doctype html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>UniRobot - Início</title>
        <meta name="description" content="UniRobot - Equipe de robótica competitiva. Inovação, tecnologia e robótica para o futuro." />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <Font cssVariable="--font-inter" preload />
    </head>
    <body>
        <section class="hero">
            <div class="hero-overlay"></div>
            <div class="hero-content">
                <h1 class="hero-title">UniRobot</h1>
                <p class="hero-subtitle">Migração para Astro em andamento</p>
            </div>
        </section>
    </body>
</html>
