---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const sponsors = (await getCollection('sponsors')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Patrocinadores">
    <main class="page-main">
    <section id="sponsors" class="sponsors">
        <div class="container">
            <h2 class="section-title">Nossos Patrocinadores</h2>
            <div class="sponsor-marquee" role="region" aria-label="Patrocinadores da UniRobot">
                <div class="sponsor-marquee-track">
                    {/* O grupo é repetido para o carrossel girar sem emenda; a cópia fica oculta para leitores de tela. */}
                    {[false, true].map((copy) => (
                        <div class="sponsor-marquee-group" aria-hidden={copy ? 'true' : undefined}>
                            {sponsors.map(({ data }) => (
                                <div class="sponsor-marquee-item"><img src={data.logo.src} alt={copy ? '' : data.alt} loading="lazy"></div>
                            ))}
                        </div>
                    ))}
                </div>
            </div>
            <div class="sponsor-details">
                <h3 class="sponsor-details-title">Conheça nossos parceiros</h3>
                <div class="sponsor-details-grid">
                    {sponsors.map(({ data }) => (
                        <article class="sponsor-detail-card">
                            <div class="sponsor-detail-logo"><img src={data.logo.src} alt={data.alt} loading="lazy"></div>
                            <h3>{data.name}</h3>
                            <p>{data.description}</p>
                        </article>
                    ))}
                </div>
            </div>
            <div class="sponsor-message">
                <p>Seja um patrocinador da UniRobot e faça parte dessa jornada!</p>
                <a href="#" class="btn btn-outline" id="openSponsorModalBtn">Torne-se um Patrocinador</a>
            </div>
        </div>
    </section>
    </main>

    {/* Modal de Patrocínio */}
    <div id="sponsorModal" class="sponsor-modal">
        <div class="sponsor-modal-content">
            <span class="sponsor-modal-close">&times;</span>

            <div class="sponsor-modal-header">
                <div class="sponsor-icon-animation">
                    <i class="fas fa-handshake"></i>
                    <i class="fas fa-star sponsor-star-1"></i>
                    <i class="fas fa-star sponsor-star-2"></i>
                    <i class="fas fa-star sponsor-star-3"></i>
                </div>
                <h2>✨ Seja um Patrocinador ✨</h2>
                <p>Faça parte da nossa jornada e ajude a construir o futuro da robótica!</p>
                <div class="sponsor-badge">
                    <i class="fas fa-trophy"></i>
                    <span>Parceiro Oficial</span>
                </div>
            </div>

            <div class="sponsor-benefits">
                <h3><i class="fas fa-gift"></i> Benefícios exclusivos</h3>
                <div class="benefits-grid">
                    <div class="benefit-item">
                        <i class="fas fa-chalkboard-user"></i>
                        <span>Logo no site e materiais</span>
                    </div>
                    <div class="benefit-item">
                        <i class="fas fa-certificate"></i>
                        <span>Certificado de parceria</span>
                    </div>
                    <div class="benefit-item">
                        <i class="fas fa-users"></i>
                        <span>Menção nas redes sociais</span>
                    </div>
                    <div class="benefit-item">
                        <i class="fas fa-video"></i>
                        <span>Destaque em vídeos</span>
                    </div>
                </div>
            </div>

            <form id="sponsorForm" class="sponsor-form">
                <div class="form-row">
                    <div class="form-group">
                        <input type="text" id="sponsor_name" name="name" required>
                        <label for="sponsor_name">
                            <i class="fas fa-building"></i>
                            Nome da Empresa / Pessoa
                        </label>
                    </div>
                </div>

                <div class="form-row double">
                    <div class="form-group">
                        <input type="email" id="sponsor_email" name="email" required>
                        <label for="sponsor_email">
                            <i class="fas fa-envelope"></i>
                            E-mail para contato
                        </label>
                    </div>
                    <div class="form-group">
                        <input type="tel" id="sponsor_phone" name="phone">
                        <label for="sponsor_phone">
                            <i class="fas fa-phone"></i>
                            Telefone (opcional)
                        </label>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <select id="sponsor_tier" name="sponsor_tier" required>
                            <option value=""></option>
                            <option value="Bronze">🥉 Bronze - R$ 100</option>
                            <option value="Prata">🥈 Prata - R$ 200</option>
                            <option value="Ouro">🥇 Ouro - R$ 500</option>
                            <option value="Platina">💎 Platina - R$ 1.000+</option>
                            <option value="Outro">🤝 Quero conversar sobre valores</option>
                        </select>
                        <label for="sponsor_tier">
                            <i class="fas fa-medal"></i>
                            Nível de Patrocínio
                        </label>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <textarea id="sponsor_message" name="message" rows="4" required></textarea>
                        <label for="sponsor_message">
                            <i class="fas fa-comment"></i>
                            Mensagem / Proposta
                        </label>
                    </div>
                </div>

                <div class="form-check">
                    <input type="checkbox" id="sponsor_terms" required>
                    <label for="sponsor_terms">
                        Concordo em receber comunicações sobre parcerias
                    </label>
                </div>

                <button type="submit" class="btn-sponsor-submit">
                    <i class="fas fa-paper-plane"></i>
                    <span>Enviar Proposta</span>
                    <i class="fas fa-arrow-right"></i>
                </button>
            </form>

            <div class="sponsor-modal-footer">
                <p>
                    <i class="fas fa-lock"></i> Seus dados estão seguros
                    <span class="separator">•</span>
                    <i class="fas fa-reply-all"></i> Respondemos em até 24h
                </p>
            </div>
        </div>
    </div>
</BaseLayout>
