---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Redes Sociais">
    <main class="page-main">
    <section id="social" class="social">
        <div class="container">
            <h2 class="section-title">Nossas Redes Sociais</h2>
            <p class="social-subtitle">Acompanhe nossa jornada nas redes sociais</p>
            <div class="social-grid">
                <a href="https://www.instagram.com/unirobot_/" target="_blank" class="social-card" title="Instagram">
                    <i class="fab fa-instagram"></i>
                    <h3>Instagram</h3>
                </a>
                <a href="https://github.com/Uni-Robots" target="_blank" class="social-card" title="GitHub">
                    <i class="fab fa-github"></i>
                    <h3>GitHub</h3>
                </a>
                <a href="https://linkedin.com" target="_blank" class="social-card" title="LinkedIn">
                    <i class="fab fa-linkedin"></i>
                    <h3>LinkedIn</h3>
                </a>
            </div>
        </div>
    </section>
    </main>
</BaseLayout>
