---
import BaseLayout from '../layouts/BaseLayout.astro';
import MemberCard from '../components/MemberCard.astro';
import { getTeamByCategory } from '../lib/team';

const groups = await getTeamByCategory();
---

<BaseLayout title="Equipe">
    <main class="page-main">
    <section id="team" class="team">
        <div class="container">
            <h2 class="section-title">Nossa Equipe</h2>

            <div id="team-sections" class="team-sections">
                {groups.map(({ id, label, members }) => (
                    <div class="team-category" id={`cat-${id}`}>
                        <div class="category-header"><h3>{label}</h3><span class="member-count">{members.length} membro{members.length > 1 ? 's' : ''}</span></div>
                        <div class="members-grid">
                            {members.map((member) => <MemberCard member={member} />)}
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>
    </main>
</BaseLayout>
